# Path to a local Gemma 4 LiteRT-LM model file or directory.
# If unset, the app first checks ../models from src/, then falls back to
# auto-downloading Gemma 4 E2B into that project models directory.
# MODEL_PATH=../models/gemma-4-E4B-it.litertlm

# Path to a local mlx-audio TTS model directory.
# If unset on Apple Silicon, the app first checks
# ../models/Qwen3-TTS-12Hz-1.7B-VoiceDesign-bf16, then downloads that model there.
# TTS_MODEL_PATH=../models/Qwen3-TTS-12Hz-1.7B-VoiceDesign-bf16
# Optional Qwen3 VoiceDesign controls.
# TTS_REF_AUDIO=../models/voices/young-female.wav
# TTS_REF_TEXT=你好，我是一个声音清晰自然的年轻女性。
# TTS_VOICE_INSTRUCT=年轻女性，普通话标准，声音清晰自然，音色稳定，语速适中。
# TTS_VOICE_LOCK=1
# TTS_VOICE_LOCK_TEXT=你好，我是你的语音助手，声音清晰自然，音色稳定。
# TTS_VOICE_LOCK_MAX_TOKENS=768
# TTS_TEMPERATURE=0
# TTS_STREAMING_INTERVAL=0.5

# Server port (default: 8000)
# PORT=8000
